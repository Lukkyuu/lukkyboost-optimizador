<UserControl x:Class="LukkyBoost.App.Views.Pages.PcDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LukkyBoost.App.Views.Controls"
             xmlns:vm="clr-namespace:LukkyBoost.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PcDashboardViewModel}"
             d:DesignWidth="1040" d:DesignHeight="760">

    <Grid>
        <Grid.RowDefinitions>
            <!-- A) Selector de Perfiles Rápidos (RadioButtons de 56px+) -->
            <RowDefinition Height="Auto" />
            <!-- B) Grid de Telemetría 2x2 con Sparklines Vectoriales (MicroGraphControl) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =============================================================== -->
        <!-- A) SELECTOR DE PERFILES RÁPIDOS (TARJETAS DE 56px+ DE ALTURA)   -->
        <!-- =============================================================== -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="-6,0,-6,18">
            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsJuegosSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Juegos">
                <StackPanel>
                    <TextBlock Text="🎮  Juegos" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Ultimate Performance • TCP NoDelay" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsCodigoSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Programacion">
                <StackPanel>
                    <TextBlock Text="💻  Código" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Docker • WSL2 • Hyper-V • DB" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsOficinaSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Oficina">
                <StackPanel>
                    <TextBlock Text="📑  Oficina" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Eficiencia energética • Silencioso" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsNormalSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Normal">
                <StackPanel>
                    <TextBlock Text="⚖️  Normal" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Configuración estándar de fábrica" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- =============================================================== -->
        <!-- B) GRID DE TELEMETRÍA 2x2 CON MICROGRAPHCONTROL (SPARKLINES)    -->
        <!-- =============================================================== -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="-8">

            <!-- 1. PROCESADOR (CPU) — Trazo #38BDF8, Fondo #082F49 (15% opacidad) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera: PROCESADOR (CPU) + % -->
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="PROCESADOR (CPU)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="22"
                                   FontWeight="ExtraBold"
                                   Foreground="#38BDF8">
                            <Run Text="{Binding CpuLoadPercent, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text="%" />
                        </TextBlock>
                    </DockPanel>

                    <!-- Modelo + Reloj y Temperatura -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock Text="{Binding CpuModel}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0">
                            <Run Text="{Binding CpuClockMhz, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                            <Run Text=" MHz   •   Temp: " />
                            <Run Text="{Binding CpuTempCelsius, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#38BDF8" FontWeight="Bold" />
                            <Run Text=" °C (" /><Run Text="{Binding CpuTempStatus, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Sparkline Vectorial Nativo (30 puntos, 1.5 px) -->
                    <controls:MicroGraphControl Grid.Row="2"
                                                MinHeight="115"
                                                Values="{Binding CpuHistory}"
                                                MaxScale="100"
                                                LineBrush="#38BDF8"
                                                FillBrush="#26082F49" />

                    <!-- Pie de estadísticas: Mín / Prom / Máx -->
                    <Grid Grid.Row="3" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Left">
                            <Run Text="Mín: " /><Run Text="{Binding CpuMinPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text="%" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center">
                            <Run Text="Prom: " /><Run Text="{Binding CpuAvgPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#38BDF8" FontWeight="Bold" /><Run Text="%" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right">
                            <Run Text="Máx: " /><Run Text="{Binding CpuMaxPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text="%" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. TARJETA GRÁFICA (GPU) — Trazo #818CF8, Fondo #1E1B4B (15% opacidad) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="TARJETA GRÁFICA (GPU)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#818CF8"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="22"
                                   FontWeight="ExtraBold"
                                   Foreground="#818CF8">
                            <Run Text="{Binding GpuLoadPercent, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text="%" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock Text="{Binding GpuModel}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="VRAM: " />
                            <Run Text="{Binding GpuVramUsedMb, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                            <Run Text="/" />
                            <Run Text="{Binding GpuVramTotalMb, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" />
                            <Run Text=" MB   •   Temp: " />
                            <Run Text="{Binding GpuTempCelsius, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#818CF8" FontWeight="Bold" />
                            <Run Text=" °C (" /><Run Text="{Binding GpuTempStatus, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>

                    <controls:MicroGraphControl Grid.Row="2"
                                                MinHeight="115"
                                                Values="{Binding GpuHistory}"
                                                MaxScale="100"
                                                LineBrush="#818CF8"
                                                FillBrush="#261E1B4B" />

                    <Grid Grid.Row="3" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Left">
                            <Run Text="Mín: " /><Run Text="{Binding GpuMinPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text="%" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center">
                            <Run Text="Prom: " /><Run Text="{Binding GpuAvgPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#818CF8" FontWeight="Bold" /><Run Text="%" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right">
                            <Run Text="Máx: " /><Run Text="{Binding GpuMaxPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text="%" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. MEMORIA (RAM) — Trazo #007AFF, Fondo #172554 (15% opacidad) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="MEMORIA (RAM)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#007AFF"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="22"
                                   FontWeight="ExtraBold"
                                   Foreground="#007AFF">
                            <Run Text="{Binding RamUsagePercent, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text="%" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="#F8FAFC">
                            <Run Text="{Binding RamUsedGb, Mode=OneWay, StringFormat={}{0:0.0}}" />
                            <Run Text=" GB / " />
                            <Run Text="{Binding RamTotalGb, Mode=OneWay, StringFormat={}{0:0.0}}" />
                            <Run Text=" GB" />
                        </TextBlock>
                        <TextBlock FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0">
                            <Run Text="Frecuencia activa: " />
                            <Run Text="{Binding RamSpeedMhz, Mode=OneWay}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                            <Run Text=" MHz   •   Dual-Channel" />
                        </TextBlock>
                    </StackPanel>

                    <controls:MicroGraphControl Grid.Row="2"
                                                MinHeight="115"
                                                Values="{Binding RamHistory}"
                                                MaxScale="100"
                                                LineBrush="#007AFF"
                                                FillBrush="#26172554" />

                    <Grid Grid.Row="3" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Left">
                            <Run Text="Mín: " /><Run Text="{Binding RamMinPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text="%" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center">
                            <Run Text="Prom: " /><Run Text="{Binding RamAvgPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#007AFF" FontWeight="Bold" /><Run Text="%" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right">
                            <Run Text="Máx: " /><Run Text="{Binding RamMaxPercent, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text="%" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. ALMACENAMIENTO (DISCO) — Trazo #10B981, Fondo #064E3B (15% opacidad) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="ALMACENAMIENTO (DISCO)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="22"
                                   FontWeight="ExtraBold"
                                   Foreground="#10B981">
                            <Run Text="{Binding StorageTransferMbPerSec, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text=" MB/s" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock Text="{Binding StorageModel}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0">
                            <Run Text="Disponible: " />
                            <Run Text="{Binding StorageFreeSpaceGb, Mode=OneWay, StringFormat={}{0:0.0}}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                            <Run Text=" GB de " />
                            <Run Text="{Binding StorageTotalSpaceGb, Mode=OneWay, StringFormat={}{0:0.0}}" Foreground="#F8FAFC" />
                            <Run Text=" GB" />
                        </TextBlock>
                    </StackPanel>

                    <controls:MicroGraphControl Grid.Row="2"
                                                MinHeight="115"
                                                Values="{Binding StorageHistory}"
                                                AutoScale="True"
                                                MaxScale="100"
                                                LineBrush="#10B981"
                                                FillBrush="#26064E3B" />

                    <Grid Grid.Row="3" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Left">
                            <Run Text="Mín: " /><Run Text="{Binding StorageMinMbPerSec, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text=" MB/s" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center">
                            <Run Text="Prom: " /><Run Text="{Binding StorageAvgMbPerSec, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#10B981" FontWeight="Bold" /><Run Text=" MB/s" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right">
                            <Run Text="Máx: " /><Run Text="{Binding StorageMaxMbPerSec, Mode=OneWay, StringFormat={}{0:0}}" Foreground="#F8FAFC" FontWeight="SemiBold" /><Run Text=" MB/s" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
