<UserControl x:Class="LukkyBoost.App.Views.Pages.PcDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:LukkyBoost.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PcDashboardViewModel}"
             d:DesignWidth="1040" d:DesignHeight="760">

    <Grid>
        <Grid.RowDefinitions>
            <!-- A) Selector de Perfiles Rápidos (RadioButtons de 56px+) -->
            <RowDefinition Height="Auto" />
            <!-- B) Grid de Telemetría 2x2 con Gráficos de 140px -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =============================================================== -->
        <!-- A) SELECTOR DE PERFILES RÁPIDOS (TARJETAS DE 56px+ DE ALTURA)   -->
        <!-- =============================================================== -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="-6,0,-6,18">
            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsJuegosSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Juegos">
                <StackPanel>
                    <TextBlock Text="🎮  Juegos" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Ultimate Performance • TCP NoDelay" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsCodigoSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Programacion">
                <StackPanel>
                    <TextBlock Text="💻  Código" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Docker • WSL2 • Hyper-V • DB" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsOficinaSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Oficina">
                <StackPanel>
                    <TextBlock Text="📑  Oficina" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Eficiencia energética • Silencioso" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="PerformanceProfiles"
                         MinHeight="56"
                         Style="{StaticResource ProfileCardRadioStyle}"
                         IsChecked="{Binding IsNormalSelected, Mode=TwoWay}"
                         Command="{Binding ApplyProfileCardCommand}"
                         CommandParameter="Normal">
                <StackPanel>
                    <TextBlock Text="⚖️  Normal" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Configuración estándar de fábrica" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- =============================================================== -->
        <!-- B) GRID DE TELEMETRÍA 2x2 (CON ALTURA EXPLÍCITA Height="140")   -->
        <!-- =============================================================== -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="-8">

            <!-- 1. CPU (Curva Cian #38BDF8) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="CPU" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ElectricCyanBrush}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource ElectricCyanBrush}">
                            <Run Text="{Binding CpuLoadPercent, Mode=OneWay}" /><Run Text="%" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock Text="{Binding CpuModel}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="{Binding CpuClockMhz, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <Run Text="MHz   •   " />
                            <Run Text="{Binding CpuTempCelsius, Mode=OneWay}" Foreground="{StaticResource ElectricCyanBrush}" FontWeight="Bold" />
                            <Run Text="°C" />
                        </TextBlock>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="2"
                                        Height="140"
                                        VerticalAlignment="Bottom"
                                        Series="{Binding CpuSeries}"
                                        XAxes="{Binding HiddenXAxis}"
                                        YAxes="{Binding PercentageYAxis}"
                                        TooltipPosition="Hidden" />
                </Grid>
            </Border>

            <!-- 2. GPU (Curva Índigo #6366F1) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="GPU" FontSize="12" FontWeight="Bold" Foreground="{StaticResource IndigoAccentBrush}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource IndigoAccentBrush}">
                            <Run Text="{Binding GpuLoadPercent, Mode=OneWay}" /><Run Text="%" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock Text="{Binding GpuModel}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="VRAM:" />
                            <Run Text="{Binding GpuVramUsedMb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <Run Text="/" />
                            <Run Text="{Binding GpuVramTotalMb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="MB   •   " />
                            <Run Text="{Binding GpuTempCelsius, Mode=OneWay}" Foreground="{StaticResource IndigoAccentBrush}" FontWeight="Bold" />
                            <Run Text="°C   •   Driver " />
                            <Run Text="{Binding GpuDriverVersion, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="2"
                                        Height="140"
                                        VerticalAlignment="Bottom"
                                        Series="{Binding GpuSeries}"
                                        XAxes="{Binding HiddenXAxis}"
                                        YAxes="{Binding PercentageYAxis}"
                                        TooltipPosition="Hidden" />
                </Grid>
            </Border>

            <!-- 3. RAM (Curva Azul #007AFF) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="RAM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ElectricBlueBrush}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource ElectricBlueBrush}">
                            <Run Text="{Binding RamUsagePercent, Mode=OneWay}" /><Run Text="%" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock FontSize="15" FontWeight="Bold">
                            <Run Text="{Binding RamUsedGb, Mode=OneWay}" />
                            <Run Text="GB /" />
                            <Run Text="{Binding RamTotalGb, Mode=OneWay}" />
                            <Run Text="GB" />
                        </TextBlock>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="Frecuencia:" />
                            <Run Text="{Binding RamSpeedMhz, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <Run Text="MHz" />
                        </TextBlock>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="2"
                                        Height="140"
                                        VerticalAlignment="Bottom"
                                        Series="{Binding RamSeries}"
                                        XAxes="{Binding HiddenXAxis}"
                                        YAxes="{Binding PercentageYAxis}"
                                        TooltipPosition="Hidden" />
                </Grid>
            </Border>

            <!-- 4. ALMACENAMIENTO (Curva Esmeralda #10B981) -->
            <Border Style="{StaticResource CyberCardStyle}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="ALMACENAMIENTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EmeraldAccentBrush}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource EmeraldAccentBrush}">
                            <Run Text="{Binding StorageTransferMbPerSec, Mode=OneWay}" /><Run Text=" MB/s" />
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock Text="{Binding StorageModel}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="Disponible:" />
                            <Run Text="{Binding StorageFreeSpaceGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <Run Text="GB de" />
                            <Run Text="{Binding StorageTotalSpaceGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="GB" />
                        </TextBlock>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="2"
                                        Height="140"
                                        VerticalAlignment="Bottom"
                                        Series="{Binding StorageSeries}"
                                        XAxes="{Binding HiddenXAxis}"
                                        YAxes="{Binding ThroughputYAxis}"
                                        TooltipPosition="Hidden" />
                </Grid>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
