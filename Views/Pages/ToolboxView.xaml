<UserControl x:Class="LukkyBoost.App.Views.Pages.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LukkyBoost.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolboxViewModel}"
             d:DesignWidth="1040" d:DesignHeight="760">

    <UserControl.Resources>
        <DataTemplate x:Key="AppRowTemplate">
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource ElectricCyanBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Button Grid.Column="4"
                            Content="{Binding ActionButtonText}"
                            Style="{StaticResource CyberActionButtonStyle}"
                            Padding="10,6"
                            Command="{Binding DataContext.InstallOrLaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra Superior: Proveedor + Buscador + Actualizar Todo -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Proveedor:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          VerticalContentAlignment="Center"
                          Margin="0,0,14,0" />

                <TextBox Grid.Column="2"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource DeepNavyBgBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource CardBorderBrush}"
                         Padding="10,7"
                         Margin="0,0,14,0"
                         VerticalContentAlignment="Center" />

                <Button Grid.Column="3"
                        Content="⬆️ Actualizar aplicaciones instaladas"
                        Style="{StaticResource CyberActionButtonStyle}"
                        Command="{Binding UpgradeAllAppsCommand}" />
            </Grid>
        </Border>

        <!-- Secciones Desplegables (Acordeones) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <Expander Header="Controladores &amp; Diagnóstico" IsExpanded="True" Foreground="{StaticResource ElectricCyanBrush}" FontWeight="Bold" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding ControladoresApps}" ItemTemplate="{StaticResource AppRowTemplate}" Margin="0,6,0,0" />
                </Expander>

                <Expander Header="Navegadores" IsExpanded="True" Foreground="{StaticResource ElectricCyanBrush}" FontWeight="Bold" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding NavegadoresApps}" ItemTemplate="{StaticResource AppRowTemplate}" Margin="0,6,0,0" />
                </Expander>

                <Expander Header="Compresión" IsExpanded="True" Foreground="{StaticResource ElectricCyanBrush}" FontWeight="Bold" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding CompresionApps}" ItemTemplate="{StaticResource AppRowTemplate}" Margin="0,6,0,0" />
                </Expander>

                <Expander Header="Juegos" IsExpanded="True" Foreground="{StaticResource ElectricCyanBrush}" FontWeight="Bold" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding JuegosApps}" ItemTemplate="{StaticResource AppRowTemplate}" Margin="0,6,0,0" />
                </Expander>

                <Expander Header="Utilidades" IsExpanded="True" Foreground="{StaticResource ElectricCyanBrush}" FontWeight="Bold" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding UtilidadesApps}" ItemTemplate="{StaticResource AppRowTemplate}" Margin="0,6,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource ElectricCyanBrush}" />
        </Border>
    </Grid>
</UserControl>
