<Window x:Class="LukkyBoost.App.Views.SplashScreenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="lukkyboost"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="500" Height="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- 1. Fade-In de entrada en 400ms -->
                    <DoubleAnimation Storyboard.TargetName="LogoRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.4" />

                    <!-- 2. Zoom suave (ScaleTransform de 0.80 a 1.0) en 400ms -->
                    <DoubleAnimation Storyboard.TargetName="LogoScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.80" To="1.0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.80" To="1.0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 3. Pulso continuo en el DropShadowEffect cian (BlurRadius animado) -->
                    <DoubleAnimation Storyboard.TargetName="EmblemGlow"
                                     Storyboard.TargetProperty="BlurRadius"
                                     From="14" To="36"
                                     Duration="0:0:1.1"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="EmblemGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.45" To="0.90"
                                     Duration="0:0:1.1"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever" />

                    <!-- 4. Gradiente cian animado en la barra inferior -->
                    <DoubleAnimation Storyboard.TargetName="GradientStopMid"
                                     Storyboard.TargetProperty="Offset"
                                     From="0.15" To="0.85"
                                     Duration="0:0:1.2"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource DeepNavyBgBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>

            <!-- Logotipo Oficial (170x170 px con HighQuality y Resplandor Cian Pulsante) -->
            <StackPanel x:Name="LogoRoot"
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.80" ScaleY="0.80" />
                </StackPanel.RenderTransform>

                <Image Source="pack://application:,,,/Assets/logo.png"
                       Width="170" Height="170"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect x:Name="EmblemGlow"
                                          Color="#38BDF8"
                                          BlurRadius="22"
                                          ShadowDepth="0"
                                          Opacity="0.70" />
                    </Image.Effect>
                </Image>

                <TextBlock Text="lukkyboost"
                           FontSize="28"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Estado de Precarga -->
            <TextBlock x:Name="PreloadStatusText"
                       Grid.Row="1"
                       Text="Verificando privilegios UAC..."
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14" />

            <!-- Barra de Progreso Horizontal Delgada con Gradiente Cian Animado -->
            <ProgressBar x:Name="PreloadProgressBar"
                         Grid.Row="2"
                         Minimum="0" Maximum="100" Value="20"
                         Height="4"
                         Background="#111827"
                         BorderThickness="0">
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#007AFF" Offset="0.0" />
                        <GradientStop x:Name="GradientStopMid" Color="#38BDF8" Offset="0.5" />
                        <GradientStop Color="#6366F1" Offset="1.0" />
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
