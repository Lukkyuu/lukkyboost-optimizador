<Window x:Class="LukkyBoost.App.Views.ProgressModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LukkyBoost.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProgressModalViewModel}"
        Title="lukkyboost"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- 1. Entrada suave del contenedor -->
                    <DoubleAnimation Storyboard.TargetName="ModalCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.25" />

                    <!-- 2. Respiración / pulso cíclico en el resplandor cian del logo (100x100 px) -->
                    <DoubleAnimation Storyboard.TargetName="ModalLogoGlow"
                                     Storyboard.TargetProperty="BlurRadius"
                                     From="14" To="34"
                                     Duration="0:0:1.1"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="ModalLogoGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.45" To="0.90"
                                     Duration="0:0:1.1"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Contenedor Principal Deep Cyber Navy (#0A0F1D) -->
    <Border x:Name="ModalCard"
            Background="#0A0F1D"
            BorderBrush="#1F293D"
            BorderThickness="1.5"
            CornerRadius="16"
            Margin="16"
            Padding="28,22,28,20">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="26"
                              ShadowDepth="0"
                              Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 1. Logotipo central superior (100x100 px) -->
                <RowDefinition Height="Auto" />
                <!-- 2. Título principal en negrita -->
                <RowDefinition Height="Auto" />
                <!-- 3. Estado o paso actual -->
                <RowDefinition Height="Auto" />
                <!-- 4. Barra de progreso redondeada + Porcentaje -->
                <RowDefinition Height="Auto" />
                <!-- 5. Caja de registro breve (1 línea) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Logotipo Oficial (100x100 px) con Resplandor Cian Pulsante -->
            <Image Grid.Row="0"
                   Source="pack://application:,,,/Assets/logo.png"
                   Width="100" Height="100"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect x:Name="ModalLogoGlow"
                                      Color="#38BDF8"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.65" />
                </Image.Effect>
            </Image>

            <!-- 2. Título Principal en Negrita -->
            <TextBlock Grid.Row="1"
                       Text="{Binding OperationTitle}"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,4" />

            <!-- 3. Estado o Paso Actual -->
            <TextBlock Grid.Row="2"
                       Text="{Binding CurrentStepDescription}"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,14" />

            <!-- 4. Barra de Progreso con Porcentaje Real -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                             Height="8"
                             BorderThickness="0"
                             Background="#111827">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                                <Border Background="#111827"
                                        CornerRadius="4" />
                                <Border x:Name="PART_Track"
                                        CornerRadius="4" />
                                <Decorator x:Name="PART_Indicator"
                                           HorizontalAlignment="Left">
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#38BDF8" Offset="0.0" />
                                                <GradientStop Color="#007AFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Decorator>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#38BDF8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 5. Registro / Log Breve de 1 Línea -->
            <Border Grid.Row="4"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Background="#111827"
                    BorderBrush="#1F293D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,0">
                <TextBlock Text="{Binding LastCompletedLog}"
                           FontFamily="Segoe UI"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>
