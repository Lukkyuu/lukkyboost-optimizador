<Window x:Class="LukkyBoost.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LukkyBoost.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="lukkyboost"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1360" Height="860"
        MinWidth="1140" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DeepNavyBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =============================================================== -->
        <!-- BARRA LATERAL IZQUIERDA FIJA (SIDEBAR)                          -->
        <!-- =============================================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,22,16,18">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Cabecera: Logotipo 38x38 + "lukkyboost" -->
                    <RowDefinition Height="Auto" />
                    <!-- Menú de navegación vertical (9 Vistas) -->
                    <RowDefinition Height="*" />
                    <!-- Botón de acción global ("⚡ Aplicar cambios") + Tarjeta de estado -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Cabecera: Logotipo 38x38 px con HighQuality y resplandor cian + "lukkyboost" -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,22">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="38" Height="38"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Effect="{StaticResource CyanGlowEffect}" />

                    <TextBlock Text="lukkyboost"
                               FontSize="22"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 2. Menú de Navegación Vertical (9 Vistas) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="💻   General"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigateTelemetryDashboardCommand}" />

                        <Button Content="🧹   Debloat"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigateDebloatCommand}" />

                        <Button Content="🛡️   Privacidad"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigatePrivacyCommand}" />

                        <Button Content="📡   Telemetría"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigateTelemetryControlCommand}" />

                        <Button Content="🚀   Rendimiento"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigatePerformanceCommand}" />

                        <Button Content="🎨   Varios"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigateMiscCommand}" />

                        <Button Content="📦   Explorar aplicaciones"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigateExploreAppsCommand}" />

                        <Button Content="🎮   Drivers"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigateDriversCommand}" />

                        <Button Content="💾   Copias de seguridad"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding NavigateBackupCommand}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Sección Inferior: Botón "⚡ Aplicar cambios" y Tarjeta "● Sistema Listo" -->
                <StackPanel Grid.Row="2" Margin="-14,12,-14,0">
                    <!-- Botón Principal "⚡ Aplicar cambios" -->
                    <Button Height="46"
                            Margin="14,0,14,10"
                            Cursor="Hand"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding ApplyAllChangesCommand}"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder"
                                        Background="#007AFF"
                                        CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#38BDF8"
                                                          BlurRadius="16"
                                                          ShadowDepth="0"
                                                          Opacity="0.45" />
                                    </Border.Effect>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="⚡"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,0,7,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Aplicar cambios"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!-- MouseOver: Fondo cian #38BDF8 y mayor resplandor -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#38BDF8" />
                                        <Setter TargetName="BtnBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#38BDF8"
                                                                  BlurRadius="24"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.80" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!-- IsPressed: Compresión sutil a 0.97 y tono #0284C7 -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#0284C7" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!-- Deshabilitado (IsEnabled="False"): Fondo #1E293B sin resplandor -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#1E293B" />
                                        <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tarjeta de Estado Inferior ("● Sistema Listo") -->
                    <Border Height="38"
                            Margin="14,0,14,0"
                            Background="#111827"
                            BorderBrush="#1F293D"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding StatusColor}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =============================================================== -->
        <!-- CONTENEDOR PRINCIPAL DE VISTAS                                  -->
        <!-- =============================================================== -->
        <Border Grid.Column="1" Padding="24">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>
